# opencode-mcp — ortam değişkenleri örneği.
# Gerçek değerler .env içine yazılır; .env ASLA commit edilmez.

# ---- OpenCode V2 sunucusu (upstream) ----
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=CHANGE_ME

# ---- MCP sunucusu ----
# stdio | http | both
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8790
# http transport için zorunlu Bearer token (gelen istekler)
MCP_AUTH_TOKEN=CHANGE_ME

# essential (güvenli; shell/api kapalı) | full
MCP_TOOL_PROFILE=essential

# debug | info | warn | error
MCP_LOG_LEVEL=info
